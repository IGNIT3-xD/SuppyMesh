model User {
    id             String     @id @default(uuid())
    organizationId String
    departmentId   String?
    email          String     @unique
    passwordHash   String?
    firstName      String
    lastName       String
    profilePic     String?
    status         UserStatus @default(PENDING)

    // --- Social Login Fields ---
    authProvider AuthProvider @default(CREDENTIAL)
    providerId   String? // Stores the Google/FB 'sub' ID

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    // Relations
    organization  Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
    department    Department?       @relation(fields: [departmentId], references: [id], onDelete: SetNull)
    roles         UserRole[]
    requests      PurchaseRequest[] @relation("Requester")
    approvals     ApprovalStep[]    @relation("Approver")
    auditLogs     AuditLog[]
    refreshTokens RefreshToken[]

    @@index([organizationId])
    @@index([departmentId])
    @@index([providerId])
}

model Role {
    id          String  @id @default(uuid())
    name        String // e.g., "PROCUREMENT_MANAGER", "FINANCE_OFFICER"
    description String?

    users UserRole[]
    steps ApprovalStep[]

    @@unique([name])
}

model UserRole {
    userId String
    roleId String

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)
    role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

    @@id([userId, roleId])
}

model RefreshToken {
    id        String   @id @default(uuid())
    userId    String
    tokenHash String   @unique
    expiresAt DateTime
    createdAt DateTime @default(now())

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@index([userId])
}
